# ── Core ──────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost/warehouse_management
JWT_SECRET=your_jwt_secret_here
PORT=5000
CLIENT_URL=http://localhost:3001

# ── Real Grain Market Prices (data.gov.in Agmarknet) ──────────────────────────
# 1. Register / Login at https://data.gov.in
# 2. Go to: My Account → API Keys → copy your key
# 3. Paste it below — prices will automatically switch from simulated to real
DATAGOV_API_KEY=your_api_key_here

# State to filter mandi prices (default: Telangana)
# Options: Telangana, Andhra Pradesh, Karnataka, Maharashtra, Punjab, etc.
DATAGOV_STATE=Telangana
